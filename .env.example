# =============================================================================
# RUZIVO — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Variables marked [Replit-managed] are injected automatically when running
# on Replit via the AI Integrations or platform environment — do NOT generate
# them manually. Variables marked [Required] must be set by you.
# =============================================================================

# -----------------------------------------------------------------------------
# API SERVER (artifacts/api-server)
# -----------------------------------------------------------------------------

# OpenAI proxy base URL — provided automatically by Replit AI Integrations.
# Do not set manually when running on Replit.
# When self-hosting, set this to your OpenAI-compatible API base URL.
# [Replit-managed]
AI_INTEGRATIONS_OPENAI_BASE_URL=

# OpenAI proxy API key — provided automatically by Replit AI Integrations.
# Do not set manually when running on Replit.
# When self-hosting, set this to your OpenAI API key.
# [Replit-managed]
AI_INTEGRATIONS_OPENAI_API_KEY=

# Gemini API credentials — provided automatically by Replit AI Integrations
# via the @workspace/integrations-gemini-ai package.
# Do not set manually when running on Replit.
# When self-hosting, configure your Gemini API key via the Google AI SDK.
# [Replit-managed]
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=

# Server port — assigned automatically by the Replit platform.
# Set to any available port when self-hosting (default: 8080).
# [Replit-managed / optional]
PORT=8080

# Pino log level. One of: trace, debug, info, warn, error, fatal.
# Defaults to "info" if not set.
# [Optional]
LOG_LEVEL=info

# Node environment. Set to "production" in deployed environments.
# [Required]
NODE_ENV=development

# -----------------------------------------------------------------------------
# EXPO MOBILE APP (artifacts/ruzivo)
# -----------------------------------------------------------------------------

# Full base URL of the API server that the mobile app calls.
# In development on Replit this is set automatically by the Expo workflow command
# to https://$REPLIT_DEV_DOMAIN so the physical phone reaches the correct server.
# In production set to your deployed API server URL, e.g. https://your-app.replit.app
# [Required]
EXPO_PUBLIC_API_URL=https://your-api-server-domain.replit.app

# Replit dev domain — assigned automatically by the Replit platform.
# Used to construct API URLs and the Expo packager proxy URL in development.
# [Replit-managed]
EXPO_PUBLIC_DOMAIN=

# Replit Repl ID — assigned automatically by the Replit platform.
# Used internally by the Expo workflow.
# [Replit-managed]
EXPO_PUBLIC_REPL_ID=

# =============================================================================
# NOTE: No API keys or secrets should ever be committed to source control.
# All secrets on Replit are managed via Replit Secrets (Environment Variables
# tab) and are never written to disk or included in the repository.
# =============================================================================
