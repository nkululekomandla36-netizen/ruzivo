#!/usr/bin/env sh
# pre-commit: block .env files and bare secret values from being committed.
# Installed automatically via the "prepare" script in package.json.
# To skip in an emergency: git commit --no-verify  (use sparingly)

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

FAIL=0

# ---------------------------------------------------------------------------
# 1. Block committed .env files (allow .env.example)
# ---------------------------------------------------------------------------
ENV_FILES=$(git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example' || true)

if [ -n "$ENV_FILES" ]; then
  printf "${RED}ERROR: Refusing to commit .env file(s):\n${NC}"
  echo "$ENV_FILES"
  echo ""
  echo "  Un-stage with:  git restore --staged <file>"
  echo "  Then add to .gitignore if it isn't already listed."
  FAIL=1
fi

# ---------------------------------------------------------------------------
# 2. Block bare secret values in staged content
# ---------------------------------------------------------------------------
PATTERN='(SECRET|PASSWORD|API_KEY|PRIVATE_KEY|ACCESS_TOKEN|AUTH_TOKEN|CLIENT_SECRET)[[:space:]]*=[[:space:]]*[A-Za-z0-9+/\-_]{16,}'
TOKEN_PATTERN='(sk-[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{35,}|ghp_[A-Za-z0-9]{36,}|ghs_[A-Za-z0-9]{36,}|xox[baprs]-[A-Za-z0-9-]+)'

# Check only the staged diff (added lines only, skip deletions)
STAGED_DIFF=$(git diff --cached --unified=0)

SECRET_HITS=$(printf '%s' "$STAGED_DIFF" | grep -E "^\+" | grep -Ev "^\+\+\+" | grep -E "$PATTERN" || true)
TOKEN_HITS=$(printf '%s' "$STAGED_DIFF" | grep -E "^\+" | grep -Ev "^\+\+\+" | grep -E "$TOKEN_PATTERN" || true)

COMBINED=$(printf '%s\n%s' "$SECRET_HITS" "$TOKEN_HITS" | sed '/^$/d')

if [ -n "$COMBINED" ]; then
  printf "${RED}ERROR: Possible secret value detected in staged changes:\n${NC}"
  echo "$COMBINED"
  echo ""
  echo "  Move secrets to environment variables / Replit Secrets."
  echo "  Reference them by name (e.g. process.env.MY_KEY) instead."
  FAIL=1
fi

# ---------------------------------------------------------------------------
if [ "$FAIL" -eq 1 ]; then
  echo ""
  printf "${RED}Commit blocked. Fix the issues above and try again.${NC}\n"
  printf "  (To bypass in an emergency: git commit --no-verify)\n"
  exit 1
fi

printf "${GREEN}pre-commit: no secrets or .env files detected.${NC}\n"
exit 0
